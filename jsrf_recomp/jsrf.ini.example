; ============================================================================
;  Jet Set Radio Future - settings
;
;  Keep this file next to jsrf_recomp.exe, in the game folder with
;  default.xbe. One setting per line, NAME=value. Lines starting with ; are
;  off: remove the ; to turn a setting on. A setting given another way (for
;  example Steam launch options) wins over this file.
; ============================================================================

[game]
; --- Needed for the game to run. Leave these as they are.
RECOMP_PB_EXEC=1
RECOMP_VBLANK=1
RECOMP_FB_WINDOW=1
RECOMP_TITLE_KEVENTS=1
RECOMP_AC97_READY=1
RECOMP_USB=1
RECOMP_KEYBOARD=1
RECOMP_KERNEL_LOG_BUDGET=0
RECOMP_WATCHDOG_SECS=0

; --- No diagnostic surveys and reports (faster). Put a ; in front when
;     making a log to report a problem.
RECOMP_QUIET=1

; --- 1 = skip the logo cards and the graffiti warning at start-up (the
;     title in a few seconds). The game's own A/START skip, applied at once.
;RECOMP_SKIP_INTRO=1

; --- Save files from a real Xbox, another emulator or a save editor load even
;     though their signature does not match. 1 = refuse them, as the Xbox does.
;RECOMP_SAVE_STRICT=1

[display]
; --- Internal resolution, a multiple of 640x480:
;     1 = 640x480, 2 = 1280x960, 3 = 1920x1440, 4 = 2560x1920.
;     2 suits the Steam Deck's 1280x800 screen.
RECOMP_GL_SCALE=2

; --- Anisotropic filtering: sharper ground and walls seen at an angle.
;     2, 4, 8 or 16 (off when not set, as on the Xbox).
;RECOMP_GL_ANISO=16

; --- Depth buffer that stays precise far away (on by default): no flicker on
;     distant walls and shadows. 0 = the console's 24-bit depth, as before.
;RECOMP_GL_WDEPTH=0

; --- No pop-in. The game normally shows only the areas visible from where
;     you are, so some buildings appear as you get close (as on the Xbox).
;     The default is hops: only what is visible from the areas the game
;     draws, 2 steps out (hops3, hops4, ... for further). Almost no pop-in,
;     without drawing the other end of a looping map (Dogenzaka Hill's
;     "copy in the sky"). game = only what the game draws, as on the Xbox;
;     all = every area, always (also draws the other end of loops).
;RECOMP_DRAW_AREAS=game
;RECOMP_DRAW_AREAS=all
;     Areas never added, per map ID:area,area;ID:area (RECOMP_AREA_PICKER=1
;     finds them: F6/F7 select, F8 skip, the list is in the log)
RECOMP_DRAW_AREAS_SKIP=EE7A:96,105

; --- Sounds never played, bank:sound,... The default mutes the Chuo Street
;     signs' electric buzz (52:35), heard all over the map here. none = all.
;RECOMP_SND_MUTE=none

; --- Start in full screen. F11 or Alt+Enter switches at any time.
RECOMP_FULLSCREEN=1

; --- Borderless window (Windows with an NVIDIA or AMD GPU; tip from Piaka).
;     With full screen on, Alt+Tab is instant and overlays work, with no
;     black flash. It moves the graphics work back onto the game's main
;     thread, so it needs a strong PC: switch it off again if frame times get
;     worse. Leave it off on the Steam Deck (it does nothing there).
;RECOMP_GL_PRESENT=dxgi

; --- Widescreen: the game shows more to the left and right instead of
;     black bars. 1 = 16:9, auto = the shape of your monitor (16:10 on a
;     Steam Deck, 21:9 on an ultrawide). For any other shape use
;     RECOMP_ASPECT=w:h instead, e.g. RECOMP_ASPECT=16:10. The HUD moves out
;     to the screen edges; the garage menus, map, character select, VS setup
;     and graffiti select are shown 4:3 while open. RECOMP_WS_HUD=0 keeps the HUD in the middle,
;     RECOMP_WS_HOLD43=0 keeps those screens wide.
;RECOMP_WIDESCREEN=1

; --- Wait for the screen's refresh (no tearing).
;RECOMP_GL_VSYNC=1

; --- Frame cap. The game is made for 60.
;RECOMP_FPS_CAP=60

[input]
; --- How many players (1 to 4). With 1, every controller and the keyboard
;     control player 1. With 2 or more (multiplayer), players join in the
;     order they press a button: the first controller or keyboard to press
;     one is player 1, the next player 2, and so on.
RECOMP_USB_PADS=1

; --- Controller rumble: 0 = off, 1 to 100 = strength in percent (default 100).
;RECOMP_RUMBLE=100

[audio]
; --- Master volume (default 0.5).
;RECOMP_APU_GAIN=0.5

; --- Echo in some areas. 0 = off.
;RECOMP_APU_REVERB=0

; --- Sound output: unset = XAudio2, wasapi = WASAPI shared.
;RECOMP_APU_BACKEND=wasapi

[files]
; --- Where the "savegame" folder goes (the hard-disk cache and partition
;     images, up to ~5 GB). Unset = in the game folder. Your save itself
;     is always in the UDATA folder of the game folder.
;     A relative path is taken from the game folder.
;RECOMP_SAVE_DIR=D:\JSRF cache

; --- Write a log (for reporting a problem). Unset = no log.
;RECOMP_LOG=stderr.txt

; --- Where the time goes, in the log. Costs several frames a second:
;     only for finding a slowdown, not for playing.
;RECOMP_PROFILE=1

[compatibility]
; --- If the game stutters (for example on a Steam Deck): check textures by
;     content instead of watching memory writes.
RECOMP_GL_TEX_WATCH=0

; --- OpenGL calls on a thread of their own (smoother frame times).
;     0 = all on one thread, as before v172 -- if something looks wrong.
;RECOMP_GL_THREAD=0

; --- How many frames that thread may fall behind:
;     0 = no added input lag (default), 1 = one frame more of slack.
;RECOMP_GL_THREAD_LAG=1

; --- Vertex work on helper threads. 0 = off.
;RECOMP_VERTEX_THREADS=0

; --- How the game's waits for the GPU behave (v183):
;     vblank = only the vblank wait sleeps (default: no music crackle on the
;     Deck, full clocks), all = both sleep (least power, but the Deck clocks
;     down and busy areas dip for a few seconds), none = both spin.
;     On a Steam Deck, all + the CPU governor set to "performance" (Decky
;     PowerTools) halves the power use at 60 fps.
;RECOMP_SLEEP_WAITS=vblank

; --- How long the GL thread spins, in microseconds, when it runs out of
;     work before it sleeps (default 3).
;RECOMP_GL_THREAD_SPIN=3
